{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Executar TypeScript",
      "type": "shell",
      "command": "npx",
      "args": ["tsx", "${file}"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
      }
    }
  ]
}
